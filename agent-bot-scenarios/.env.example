# Порт, на котором слушает роутер бота (это и есть outgoing_url бота в Chatwoot)
PORT=8000

# Адрес вашего Chatwoot (без слэша на конце)
# Локально:      http://localhost:3000
# На дроплете:    http://188.166.123.233:3001  (или ваш домен)
CHATWOOT_BASE_URL=http://localhost:3000

# ID аккаунта Chatwoot (Account.find_each — обычно 1 локально, у вас на проде — 5)
CHATWOOT_ACCOUNT_ID=1

# Access token бота — получить командой в rails console:
#   bot = AgentBot.create!(name: "SlideEdu Scenario Bot", outgoing_url: "http://<адрес-этого-сервиса>:8000/webhook")
#   bot.access_token.token
CHATWOOT_BOT_TOKEN=

# Secret бота (bot.secret) — используется для проверки подписи входящих вебхуков.
# Необязательно, но настоятельно рекомендуется в проде.
AGENT_BOT_SECRET=

# Лейбл, который навешивается на диалог при передаче человеку-специалисту
HANDOFF_LABEL=finance-request

# Личный API-токен АДМИНИСТРАТОРА аккаунта (не бота!) — нужен для /dashboard
# (отчёты /reports/summary доступны только администратору), для назначения
# диалога на команду (GET /teams запрещён токену бота) и для списка команд
# в редакторе сценария /admin. Взять в самом Chatwoot: Profile Settings
# (иконка профиля внизу слева) → Access Token → скопировать. Без этой
# переменной бот работает как обычно, просто /dashboard и назначение на
# команду отдают понятную ошибку/предупреждение вместо данных.
CHATWOOT_ADMIN_TOKEN=

# Отдельных переменных для входа в визуальный редактор сценария (/admin) не
# нужно — доступ проверяется живьём по личному access token'у того, кто
# заходит (см. README → "Редактор сценария").
